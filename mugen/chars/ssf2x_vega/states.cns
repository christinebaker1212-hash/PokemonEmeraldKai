; States
;---------------------------------------------------------------------------
; Lose by Time Over
[Statedef 170]
type = S
anim = 170
velset = 0,0
ctrl = 0

[State 170, NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 170, State]
type = ChangeState
triggerall = MatchOver
triggerall = RoundState > 3
triggerall = AnimExist(9001) || AnimExist(9005)
trigger1 = NumEnemy > 0
trigger1 = Enemy(0), StateNo = 9000 || Enemy(NumEnemy = 2), StateNo = 9000
trigger1 = Enemy(0), Var(15) = 1234567890 || Enemy(NumEnemy = 2), Var(15) = 1234567890
value = 9110

[State 170, Anim]
type = ChangeAnim
trigger1 = Time <= 0
trigger1 = Var(50) > 0
trigger1 = AnimExist(171)
value = 171

;---------------------------------------------------------------------------
; Win Pose
[Statedef 180]
type = S
velset = 0,0
ctrl = 0

[State 180, Special]
type = AssertSpecial
trigger1 = Time < 150
flag = RoundNotOver

[State 180, NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 180, VarRandom]
type = VarRandom
trigger1 = Time <= 0
v = 0
range = 0,9

[State 180, VarRandom]
type = VarRandom
trigger1 = Var(50) = 30
trigger1 = Time <= 0
v = 1
range = 13,14

[State 180, Anim]
type = ChangeAnim
trigger1 = Time <= 0
trigger1 = Var(0) >= 0
trigger1 = Var(0) <= 4
value = 180

[State 180, Anim]
type = ChangeAnim
trigger1 = Time <= 0
trigger1 = Var(0) >= 5
trigger1 = Var(0) <= 9
trigger1 = Var(51) > 0
value = 181

[State 180, Anim]
type = ChangeAnim
trigger1 = Time <= 0
trigger1 = Var(0) >= 5
trigger1 = Var(0) <= 9
trigger1 = Var(51) <= 0
value = 185

[State 180, PlaySnd]
type = PlaySnd
triggerall = Var(50) <= 0
trigger1 = Anim = 185
trigger1 = AnimElem = 9
value = 5, 1 + Var(50)
channel = 0

[State 180, PlaySnd]
type = PlaySnd
triggerall = Var(50) > 0
triggerall = Var(50) < 30
triggerall = Var(51) > 0
trigger1 = Anim = 180
trigger1 = AnimElem = 1
value = 5, 2 + Var(50)
channel = 0

[State 180, PlaySnd]
type = PlaySnd
trigger1 = Var(50) <= 0 || Var(51) <= 0
trigger1 = Anim = 180
trigger1 = AnimElem = 1
trigger2 = Anim = 181
trigger2 = AnimElem = 1
value = 5, 3 + Var(50)
channel = 0

[State 180, PlaySnd]
type = PlaySnd
triggerall = Var(50) = 30
triggerall = Var(51) > 0
trigger1 = Anim = 180
trigger1 = AnimElem = 2
value = 10, 2
channel = 0

[State 180, PlaySnd]
type = PlaySnd
triggerall = Var(50) = 30
trigger1 = Anim = 185
trigger1 = AnimElem = 9
value = 10, Var(1)
channel = 0

;----- Win Quote -----
[State 180, State]
type = ChangeState
triggerall = MatchOver
triggerall = Time >= 100
triggerall = NumEnemy > 0
triggerall = RoundState > 3
triggerall = EnemyNear, AnimExist(9001) || EnemyNear, AnimExist(9005)
trigger1 = Var(15) = 1234567890
value = 9000
;---------------------

;---------------------------------------------------------------------------
; Introduction
[Statedef 190]
type = S
physics = N
velset = 0,0
sprpriority = 2
anim = 0
ctrl = 0

[State 190, Intro]
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 190, State]
type = ChangeState
trigger1 = Time > 0
value = 0

;---------------------------------------------------------------------------
; Taunt
[Statedef 195]
type = S
movetype = I
physics = S
velset = 0,0
ctrl = 0

[State 195, State]
type = ChangeState
trigger1 = Time > 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Stand Light Punch
[Statedef 200]
type = S
movetype = A
physics = S
velset = 0,0
juggle = 100
anim = 200
ctrl = 0

[State 200, Anim]
type = ChangeAnim
trigger1 = Time <= 0
trigger1 = Var(20) > 0
value = Anim + 1

[State 200, PlaySnd]
type = PlaySnd
triggerall = Var(50) != 30 || Var(50) = 30 && Var(20) > 0
trigger1 = AnimElem = 1
value = 1, 0 + Var(50)
channel = 1

[State 200, PlaySnd]
type = PlaySnd
triggerall = Var(20) <= 0
triggerall = Var(50) = 30
trigger1 = AnimElem = 1
value = 1, 4 + Var(50)
channel = 2

[State 200, HitDef]
type = HitDef
trigger1 = AnimElem = 2
attr = S, NA
damage = IfElse(Var(20) <= 0, 55, 50), 0
animtype = Light
guardflag = M
hitflag = MA
priority = 3, Hit
pausetime = 6, 6
guard.sparkno = S6050
sparkno = S6000 + (TeamSide = 2) * 10
sparkxy = -20 * ceil(const(size.xscale)), -80 * ceil(const(size.yscale))
ground.type = High
ground.slidetime = 8
ground.hittime = 12
ground.velocity = -6
airguard.velocity = -2,-3
air.type = Low
air.velocity = -2,-3
air.hittime = 12

[State 200, Explod] ;Blood Spark
type = Explod
triggerall = NumTarget > 0
triggerall = Var(20) <= 0
trigger1 = MoveHit
ignorehitpause = 1
anim = 6040
sprpriority = 10
pos = target,const(size.ground.front) - (20 * ceil(const(size.xscale))), ceil(pos y-target,pos y) - (80 * ceil(const(size.yscale)))
postype = p2
random = 10,10
pausemovetime = -1
supermovetime = -1
facing = IfElse((target,facing = facing), 1, -1)
ownpal = 1

;----- Hit Sound -----
[State 200, Hit]
type = PlaySnd
trigger1 = MoveHit
ignorehitpause = 1
value = 2, IfElse(Var(20) > 0, 1 + Var(50), 8 + Var(50))
channel = 2

[State 200, Guard]
type = PlaySnd
trigger1 = MoveGuarded
ignorehitpause = 1
value = 2, 0 + Var(50)
channel = 2

[State 200, Reset]
type = MoveHitReset
trigger1 = MoveContact
ignorehitpause = 1
;--------------------

[State 200, State]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

