;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------
[Statedef -3]

;----- Opponent Check -----
[State -3, VarSet]
type = VarSet
triggerall = Win
triggerall = Alive
triggerall = MatchOver
triggerall = NumTarget > 0
triggerall = RoundState > 2
triggerall = Var(41) >= Var(42) - 1
trigger1 = Target, AnimExist(9001) || Target, AnimExist(9005)
ignorehitpause = 1
v = 6
value = 1

[State -3, State]
type = TargetState
triggerall = Var(6) > 0
triggerall = NumTarget > 0
trigger1 = Target, StateType = L
trigger1 = Target, StateNo >= 5110
trigger1 = Target, StateNo < 5120
ignorehitpause = 1
value = 9111

[State -3, VarSet]
type = VarSet
trigger1 = RoundState <= 2
;trigger2 = RoundsExisted <= 0
ignorehitpause = 1
v = 15
value = 0

[State -3, VarSet]
type = VarSet
triggerall = Win
triggerall = Alive
triggerall = MatchOver
triggerall = RoundState > 2
triggerall = Var(41) >= Var(42) - 1
trigger1 = NumTarget > 0
trigger1 = Target, AnimExist(9001) || Target, AnimExist(9005)
trigger1 = Target, StateNo = 9111
trigger2 = NumEnemy > 0
trigger2 = EnemyNear, AnimExist(9001) || EnemyNear, AnimExist(9005)
trigger2 = EnemyNear, StateNo = 9111
ignorehitpause = 1
v = 15
value = 1234567890

[State -3, Drop]
type = TargetDrop
triggerall = Var(6) > 0
triggerall = NumTarget > 0
trigger1 = Target, StateNo = 9111
ignorehitpause = 1

[State -3, Helper]
type = Helper
triggerall = Win
triggerall = Alive
triggerall = MatchOver
triggerall = NumEnemy > 0
triggerall = NumTarget <= 0
triggerall = RoundState > 2
triggerall = Var(41) >= Var(42) - 1
trigger1 = EnemyNear, AnimExist(9001) || EnemyNear, AnimExist(9005)
trigger1 = NumHelper(9100) <= 0
helpertype = normal
name = "Target Check"
id = 9100
pos = 0, 0
stateno = 9100
keyctrl = 0
