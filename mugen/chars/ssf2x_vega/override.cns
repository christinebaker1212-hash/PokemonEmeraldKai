;===== Dizzy Counter =====
;----- Start Max -----
[State -2, VarSet]
type = VarSet
trigger1 = Var(8) <= 0
trigger2 = RoundState < 2
ignorhitpause = 1
v = 8
value = 20
;-------------------------

;----- Damage Hits -----
[State -2, Light Hit]
type = VarAdd
triggerall = Alive
triggerall = Time <= 0
triggerall = NumEnemy > 0
triggerall = MoveType = H
triggerall = StateType != L
triggerall = StateNo >= 5000
triggerall = GetHitVar(animtype) <= 0
trigger1 = EnemyNear, HitDefAttr = SCA, NA, NT, NP
trigger2 = EnemyNear, HitDefAttr = SCA, SA, ST, SP
trigger3 = GetHitVar(hitcount) < 5
ignorhitpause = 1
v = 7
value = 2

[State -2, Medium Hit]
type = VarAdd
triggerall = Alive
triggerall = Time <= 0
triggerall = NumEnemy > 0
triggerall = MoveType = H
triggerall = StateType != L
triggerall = StateNo >= 5000
triggerall = GetHitVar(animtype) = 1
trigger1 = EnemyNear, HitDefAttr = SCA, NA, NT, NP
trigger2 = EnemyNear, HitDefAttr = SCA, SA, ST, SP
trigger3 = GetHitVar(hitcount) < 5
ignorhitpause = 1
v = 7
value = 4

[State -2, Heavy Hit]
type = VarAdd
triggerall = Alive
triggerall = Time <= 0
triggerall = NumEnemy > 0
triggerall = MoveType = H
triggerall = StateType != L
triggerall = StateNo >= 5000
triggerall = GetHitVar(animtype) = 2
trigger1 = EnemyNear, HitDefAttr = SCA, NA, NT, NP
trigger2 = EnemyNear, HitDefAttr = SCA, SA, ST, SP
trigger3 = GetHitVar(hitcount) < 5
ignorhitpause = 1
v = 7
value = 6

[State -2, Falling Hit]
type = VarAdd
triggerall = Alive
triggerall = Time <= 0
triggerall = NumEnemy > 0
triggerall = MoveType = H
triggerall = StateType != L
triggerall = StateNo >= 5000
triggerall = GetHitVar(animtype) >= 3
trigger1 = EnemyNear, HitDefAttr = SCA, NA, NT, NP
trigger2 = EnemyNear, HitDefAttr = SCA, SA, ST, SP
trigger3 = GetHitVar(hitcount) < 5
ignorhitpause = 1
v = 7
value = 8

[State -2, Thrown]
type = VarAdd
triggerall = Alive
triggerall = Time <= 0
triggerall = NumEnemy > 0
triggerall = MoveType = H
triggerall = StateType != L
trigger1 = StateNo >= 160
trigger1 = StateNo < 5000
trigger1 = Anim < 800
ignorhitpause = 1
v = 7
value = 5
;-------------------------

;----- Decrease Over Time -----
[State -2, VarAdd]
type = VarAdd
triggerall = Alive
triggerall = Var(7) > 0
trigger1 = MoveType != H
trigger1 = TimeMod = 50,25
trigger1 = Time > 0
v = 7
value = -1
;-------------------------

;----- Reset Variables -----
[State -2, VarSet]
type = VarSet
trigger1 = !Alive
trigger1 = MoveType = H
trigger2 = MoveType != H
trigger2 = Var(7) >= Var(8)
trigger3 = Var(7) < 0
trigger4 = StateNo >= 5300
trigger4 = StateNo < 5500
trigger5 = Time <= 0
trigger5 = MoveType = H
trigger5 = NumEnemy > 0
trigger5 = EnemyNear, HitDefAttr = SCA, HA, HT, HP
trigger6 = Time > 0
trigger6 = MoveType != H
trigger6 = TimeMod = 200, 100
trigger7 = StateNo >= 150
trigger7 = StateNo < 160
trigger7 = Var(7) > 0
ignorehitpause = 1
v = 7
value = 0

[State -2, VarSet]
type = VarSet
trigger1 = !Alive
trigger1 = MoveType = H
trigger2 = StateNo >= 5300
trigger2 = StateNo < 5400
trigger3 = MoveType != H
trigger4 = Var(9) < 0
v = 9
value = 0
;-------------------------

;----- Actually Dizzy -----
[State -2, VarSet]
type = VarSet
trigger1 = Var(7) >= Var(8)
v = 7
value = Var(8)

[State -2, VarSet]
type = VarSet
triggerall = Alive
trigger1 = Var(7) >= Var(8)
v = 9
value = 1

