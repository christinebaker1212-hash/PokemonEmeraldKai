;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]

;----- Cage Dropped -----
[State -2, VarAdd]
type = VarAdd
triggerall = Var(58) < 100
triggerall = StageVar(info.author) = "Dark Saviour"
trigger1 = StageVar(info.name) = "[SSFIIX] Vega"
trigger2 = StageVar(info.name) = "[SFII'CE] Vega" || StageVar(info.name) = "[SFII] Vega"
trigger2 = Var(58) <= 0
ignorehitpause = 1
var(58) = 1

[State -2, PlaySnd]
type = PlaySnd
triggerall = StageVar(info.name) = "[SSFIIX] Vega"
triggerall = StageVar(info.author) = "Dark Saviour"
trigger1 = Var(58) = 81
ignorehitpause = 1
value = 6, 2
;-------------------------

;----- Variable Reset -----
[State -2, VarAdd]
type = VarSet
triggerall = Var(58) > 0
triggerall = StageVar(info.author) != "Dark Saviour"
trigger1 = StageVar(info.name) != "[SSFIIX] Vega"
trigger1 = StageVar(info.name) != "[SFII'CE] Vega"
trigger1 = StageVar(info.name) != "[SFII] Vega"
ignorehitpause = 1
var(58) = 0
;-------------------------

;----- Pause Menu -----
[State -2, Pause]
type = Helper
triggerall = Var(59) <= 0
triggerall = NumHelper(8500) <= 0
triggerall = RoundState < 2
trigger1 = Command = "start"
helpertype = normal
size.ground.back = 0
size.ground.front = 0
size.air.back = 0
size.air.front = 0
name = "Pause"
id = 8500
pos = 0, 0
postype = P1
stateno = 8500
keyctrl = 1
ownpal = 1

[State 8500, VarSet]
type = VarSet
trigger1 = Var(55) <= 0
ignorehitpause = 1
var(55) = PalNo

[State -2, RemapPal]
type = RemapPal
trigger1 = Var(55) > 0
ignorehitpause = 1
source = 1,1
dest = 1,Var(55)

[State 8500, VarSet]
type = VarSet
trigger1 = Var(59) <= 0
trigger1 = NumHelper(8500) > 0
ignorehitpause = 1
var(59) = 1
;-------------------------

;----- II' Icon -----
[State -2, PlaySnd]
type = PlaySnd
triggerall = Ctrl
triggerall = Var(59) <= 0
triggerall = AILevel <= 0
triggerall = Name != "SF2'CE Vega"
trigger1 = Command != "climb_s"
trigger1 = Command != "roll_s"
trigger1 = Command != "sid_s"
trigger1 = Command = "start"
ignorehitpause = 1
value = 7, 0
channel = 3

[State -2, Explod]
type = Explod
triggerall = Name != "SF2'CE Vega"
triggerall = NumExplod(7000) <= 0
triggerall = NumHelper(8500) <= 0
triggerall = Var(51) > 0
trigger1 = TeamSide = 1
pausemovetime = -1
supermovetime = -1
ignorehitpause = 1
sprpriority = 50
removetime = -1
postype = left
bindtime = -1
anim = 7000
id = 7000
facing = 1
pos = 5,220
ownpal = 1
ontop = 1

[State -2, Explod]
type = Explod
triggerall = Name != "SF2'CE Vega"
triggerall = NumExplod(7000) <= 0
triggerall = NumHelper(8500) <= 0
triggerall = Var(51) > 0
trigger1 = TeamSide = 2
pausemovetime = -1
supermovetime = -1
ignorehitpause = 1
sprpriority = 50
removetime = -1
postype = right
bindtime = -1
anim = 7000
id = 7000
facing = 1
pos = -25,220
ownpal = 1
ontop = 1

[State -2, RemoveExplod]
type = RemoveExplod
triggerall = NumExplod(7000) > 0
trigger1 = Var(51) <= 0 
ignorehitpause = 1
id = 7000

[State -2, ModifyExplod]
type = ModifyExplod
triggerall = NumExplod(7000) > 0
trigger1 = StateNo >= 9000
ignorehitpause = 1
sprpriority = 0
ontop = 0
id = 7000
;--------------------

;====================
;--------------------
; Sound Options
;--------------------
; SF2'CE Sounds
[State -2, VarSet]
type = VarSet
triggerall = Var(52) <= 0
trigger1 = PalNo >= 4
trigger1 = PalNo < 7
trigger2 = Name = "SF2'CE Vega"
trigger2 = PalNo >= 10
trigger2 = PalNo < 13
ignorehitpause = 1
var(50) = 10

; SF2X Sounds
[State -2, VarSet]
type = VarSet
triggerall = Var(52) <= 0
trigger1 = Name != "SF2'CE Vega"
trigger1 = PalNo >= 1
trigger1 = PalNo < 4
ignorehitpause = 1
var(50) = 0

; SNES Sounds
[State -2, VarSet]
type = VarSet
triggerall = Var(52) <= 0
trigger1 = Name != "SF2'CE Vega"
trigger1 = PalNo >= 10
trigger1 = PalNo < 13
trigger2 = Name = "SF2'CE Vega"
trigger2 = PalNo >= 1
trigger2 = PalNo < 4
trigger3 = Name = "SF2'CE Vega"
trigger3 = PalNo >= 7
trigger3 = PalNo < 10
ignorehitpause = 1
var(50) = 20

; SF Alpha Sounds
[State -2, VarSet]
type = VarSet
triggerall = Var(52) <= 0
trigger1 = Name != "SF2'CE Vega"
trigger1 = PalNo >= 7
trigger1 = PalNo < 10
ignorehitpause = 1
var(50) = 30

[State -2, VarSet]
type = VarSet
triggerall = Var(52) <= 0
trigger1 = Var(50) >= 10
trigger1 = Var(50) < 30 
ignorehitpause = 1
var(51) = 1

[State -2, VarSet]
type = VarSet
trigger1 = Var(52) <= 0
ignorehitpause = 1
var(52) = 1
;====================

;--------------------
; Claw Attachment
[State -2, Helper]
type = Helper
triggerall = NumHelper(10000) <= 0
trigger1 = Var(20) <= 0
helpertype = normal
name = "Claw"
pausemovetime = 1000000000
supermovetime = 1000000000
ignorehitpause = 1
id = 10000
pos = 0,0
postype = p1
stateno = 10000
keyctrl = 0

[State -2, VarRandom]
type = VarRandom
triggerall = NumHelper(10000) > 0
trigger1 = Var(21) <= 0
ignorehitpause = 1
v = 21
range = 25,50

[State -2, VarAdd]
type = VarAdd
triggerall = Time <= 1
triggerall = NumHelper(10000) > 0
triggerall = Var(22) < Var(21)
triggerall = HitShakeOver = 0
trigger1 = MoveType = H
ignorehitpause = 1
var(22) = 1

[State -2, VarSet]
type = VarSet
triggerall = NumHelper(10000) > 0
triggerall = Var(22) >= Var(21)
triggerall = HitShakeOver = 0
trigger1 = MoveType = H
ignorehitpause = 1
var(20) = 1

[State -2, VarSet]
type = VarSet
trigger1 = Var(20) > 0
ignorehitpause = 1
var(22) = 0

[State -2, PlaySnd]
type = PlaySnd
triggerall = Var(50) = 30
triggerall = NumHelper(10000) > 0
trigger1 = Var(20) <= -1
ignorehitpause = 1
value = 10, 13 + Helper(10000), Var(1)
channel = 0

[State -2, VarSet]
type = VarSet
trigger1 = Var(20) <= 0
ignorehitpause = 1
var(20) = 0
;--------------------

;----- No Juggle Check -----
[State -2, AssertSpecial]
type = AssertSpecial
triggerall = NumEnemy > 0
trigger1 = EnemyNear, StateType != A
trigger2 = EnemyNear, Pos Y = 0
ignorehitpause = 1
flag = NoJuggleCheck
;--------------------------

;----- Win/Lose Count -----
[State -2, VarSet]
type = VarSet
trigger1 = RoundState <= 2
trigger2 = RoundsExisted <= 0
ignorehitpause = 1
v = 40
value = 0

[State -2, VarSet]
type = VarSet
trigger1 = RoundsExisted <= 0
ignorehitpause = 1
v = 41
value = 0

[State -2, VarSet]
type = VarSet
trigger1 = RoundsExisted <= 0
ignorehitpause = 1
v = 42
value = 0

[State -2, VarAdd]
type = VarAdd
trigger1 = RoundState > 3
ignorehitpause = 1
v = 40
value = 1

[State -2, Win]
type = VarAdd
triggerall = Win
trigger1 = RoundState > 3
trigger1 = Var(40) = 1
ignorehitpause = 1
v = 41
value = 1

[State -2, Lose]
type = VarAdd
triggerall = Lose
trigger1 = RoundState > 3
trigger1 = Var(40) = 1
ignorehitpause = 1
v = 42
value = 1
;--------------------------

[State -2, VarSet]
type = VarSet
trigger1 = MoveType = A
ignorehitpause = 1
v = 3
value = Anim

