;---------------------------------------------------------------------------
;Super Street Fighter 2X Vega(Gouki) stage
;---------------------------------------------------------------------------
;改変、素材利用については特に制限は設けません
;背景の人々とか変えてみたら面白そうですなw
;


[Info]
name = "SF2 Thailand 2 - M.Bison Stage"
displayname = "THAILAND - M. BISON"

[Camera]
startx = 0
starty = 0
boundleft = -227
boundright = 227
boundhigh = -15
boundlow = 0
verticalfollow = 0.3
tension = 50
floortension = 60

[PlayerInfo]
;--- Player 1 ---
p1startx = -80
p1starty = 0
p1startz = 0
p1facing = 1

;--- Player 2 ---
p2startx = 80
p2starty = 0
p2startz = 0
p2facing = -1

;--- Common ---
leftbound  = -1000
rightbound =  1000
topbound  =  0
botbound  =  0

[Scaling]
topz     = 0
botz     = 50
topscale = 1
botscale = 1.2

[Bound]
screenleft = 15
screenright = 15

[StageInfo]
zoffset = 215
autoturn = 1
resetBG = 1

[Shadow]
color = 106,90,90  ;96,112,80
yscale = 0.16
reflect = 0
intensity = 32

[Reflection]
intensity = 0

[Music]
bgmusic = sound/SF2 Dictator - M.Bison Theme.mp3
bgvolume = 210

[BGdef]
spr = sf2-thailand2.sff
debugbg = 1

;====================================================================

