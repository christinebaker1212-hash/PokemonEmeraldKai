leftbound=-1000
rightbound=1000
topbound=0
botbound=0

[Scaling]
topz=0
botz=50
topscale=1
botscale=1.4

[Bound]
screenleft=15
screenright=15

[StageInfo]
zoffset=225
autoturn=1
resetBG   = 0  

[Shadow]
color = 128,128,128
yscale = .159

[Music]
bgmusic= sound/SF2 Jamaica - Deejay Theme.mp3
bgvolume=20

[BGdef]
