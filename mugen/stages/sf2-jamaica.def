; Autor : Juan Carlos http://eternalmugen.cjb.net, basado en el stage de deejey 

[Info]
name="SF2 Jamaica - Deejay Stage" 
autor= JC

[Camera]
startx=0
starty=0
boundleft = -180
boundright = 166
boundhigh = -14
floortension=0
tension=60

[PlayerInfo]
p1startx=-70
p1starty=0
p1startz=0
p1facing=1

p2startx=70
p2starty=0
p2startz=0
