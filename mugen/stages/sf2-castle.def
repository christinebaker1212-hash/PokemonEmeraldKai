[Info]
name = "SF2 Dusk Castle - Akuma Stage"
author = "TheMysterykid14"

;--------------------------------------------------------
[Camera]
startx = 0
starty = 0
boundleft = -95
boundright = 95
boundhigh = -15
boundlow = 0
verticalfollow = .2
floortension = 0
tension = 50

;--------------------------------------------------------
[PlayerInfo]
;--- Player 1 ---
p1startx = -70          ;Starting x coordinates
p1starty = 0            ;Starting y coordinates
p1startz = 0            ;Starting z coordinates
p1facing = 1            ;Direction player faces: 1=right, -1=left

;--- Player 2 ---
p2startx = 70
p2starty = 0
p2startz = 0
p2facing = -1

;--- Common ---
leftbound  = -1000 ;Left bound (x-movement)
rightbound =  1000 ;Right bound
topbound  =  0     ;Top bound (z-movement)
botbound  =  0     ;Bottom bound

;--------------------------------------------------------
[Scaling]
topz     = 0       ;Top z-coordinate for scaling
botz     = 50      ;Bottom z-coordinate for scaling
topscale = 1       ;Scale to use at top
botscale = 1.2     ;Scale to use at bottom

;--------------------------------------------------------
[Bound]
screenleft = 15    
screenright = 15   

;--------------------------------------------------------
[StageInfo]
zoffset = 225
autoturn = 1
resetBG = 1
Hires = 0
floortension = 90

;--------------------------------------------------------
[Shadow]
intensity = 150
color = 255,255,51
yscale = 0.4
fade.range = 0,0

;--------------------------------------------------------
[Reflection]
intensity = 0

;--------------------------------------------------------
[Music]

bgmusic = sound/SF2 Raging Demon - Akuma Theme.mp3
bgvolume = 255

;--------------------------------------------------------
[BGdef]
spr = sf2-castle.sff
debugbg = 0

;----------
[BG 0]
type  = normal
spriteno = 0, 0
layerno = 0            
start = 0, 0
delta = 1, 1
trans = none
mask  = 0
tile  = 1, 0
tilespacing = 0,0
window = 0,0, 319, 239

;----------
[BG 1]
type  = normal
spriteno = 0, 1
start = 0, 220
delta = 1, 1
mask = 1
velocity = 0, 0
tile = 1, 0
tilespacing = 0, 0
