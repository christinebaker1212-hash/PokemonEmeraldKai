	STD_QZ_11 = 11
	STD_QZ_12 = 12

	@ givemon whose two words / byte stock Emerald leaves 0 (Quetzal uses them; meaning in docs/quetzal/SCRIPT_COMMANDS.md)
	.macro qz_givemon_ex species:req, level:req, item:req, w1:req, w2:req, b:req
	.byte SCR_OP_GIVEMON
	.short \species
	.byte \level
	.short \item
	.int \w1
	.int \w2
	.byte \b
	.endm

	@ trainerbattle type 13 (Quetzal): like TRAINER_BATTLE_SINGLE; see docs/quetzal/SCRIPT_COMMANDS.md
	.macro qz_trainerbattle_13 trainer:req, local_id:req, intro:req, defeat:req
	.byte SCR_OP_TRAINERBATTLE
	.byte 13
	.short \trainer
	.short \local_id
	ptrvalue \intro
	ptrvalue \defeat
	.endm

