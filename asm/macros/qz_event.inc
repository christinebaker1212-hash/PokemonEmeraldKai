@ Generated by tools/quetzal_port/import.py from tools/quetzal_rip's. Quetzal's script commands 0xE3-0xF5 as raw bytes, and its new
@ specials / std scripts as numbers, so quetzal_rip/*.inc assembles. They do nothing in Kai until ported.

	@ bufferfollowerspecies: b strVarIndex (plays the follower's cry, buffers its species name; follower slot 1, or 2 in Giovanni mode)
	.macro qz_bufferfollowerspecies a0:req
	.byte 0xE3
	.byte \a0
	.endm

	@ getplayergender: - (VAR_RESULT = gSaveBlock2->playerGender, 0xFF in Giovanni mode)
	.macro qz_getplayergender 
	.byte 0xE4
	.endm

	@ questmenu: b op, b questVar (0 open quest menu [waits], 1 nop, 2 set flag, 3 VAR_RESULT=unlocked, 4 VAR_RESULT=flag, 5 buffer quest name)
	.macro qz_questmenu a0:req, a1:req
	.byte 0xE5
	.byte \a0
	.byte \a1
	.endm

	@ waitframe_vars: b ignored, h var, h var (reads both, does nothing, yields one frame)
	.macro qz_waitframe_vars a0:req, a1:req, a2:req
	.byte 0xE6
	.byte \a0
	.2byte \a1
	.2byte \a2
	.endm

	@ setfollowergfxvar: b mode (0 VAR_OBJ_GFX_ID_1, 1 VAR_OBJ_GFX_ID_F, 2 GFX_ID_1+GFX_ID_0, 3 VAR_OBJ_GFX_ID_3 from selected party mon)
	.macro qz_setfollowergfxvar a0:req
	.byte 0xE7
	.byte \a0
	.endm

