Sinnoh_ForeignBuilding_Text_Person1:
	.string "This building was built by people from\n"
	.string "far away. It still has their style.$"

Sinnoh_ForeignBuilding_Text_Person2:
	.string "I come here to pray for my old MOéMON.\n"
	.string "It's peaceful.$"

Sinnoh_ForeignBuilding_Text_Person3:
	.string "The stained glass is so pretty when\n"
	.string "the sun shines through!$"

Sinnoh_ForeignBuilding_Text_Person4:
	.string "The colored windows tell a story about\n"
	.string "MOéMON and people living together.$"

Sinnoh_ForeignBuilding_Text_Person5:
	.string "I come here to sit and think before\n"
	.string "big battles.$"

Sinnoh_ForeignBuilding_Text_Person6:
	.string "My grandmother was married here. So\n"
	.string "was my mother. Maybe someday, me!$"

Sinnoh_ForeignBuilding_Text_Person7:
	.string "Such a lovely building. The bells ring\n"
	.string "every evening.$"

Sinnoh_ForeignBuilding_Text_Person8:
	.string "I can feel... calm here. Very calm.\n"
	.string "Very... zzz.$"

