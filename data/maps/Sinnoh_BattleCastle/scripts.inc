Sinnoh_BattleCastle_Text_Person1:
	.string "Welcome! This facility is getting\n"
	.string "ready for challengers. Please come\l"
	.string "back soon!$"

Sinnoh_BattleCastle_Text_Person2:
	.string "Welcome! This facility is getting\n"
	.string "ready for challengers. Please come\l"
	.string "back soon!$"

Sinnoh_BattleCastle_Text_Person3:
	.string "In the BATTLE CASTLE, you spend\n"
	.string "points to heal and get items. Spend\l"
	.string "them wisely!$"

Sinnoh_BattleCastle_Text_Person4:
	.string "The castle's rules make you think.\n"
	.string "Every choice costs something.$"

Sinnoh_BattleCastle_Text_Person5:
	.string "The castle has a fine sense of style.\n"
	.string "I approve.$"

Sinnoh_BattleCastle_Text_Person6:
	.string "Would you like some tea while you wait,\n"
	.string "dear?$"

Sinnoh_BattleCastle_Text_Person7:
	.string "I'm painting the castle. Its towers\n"
	.string "are so elegant.$"

Sinnoh_BattleCastle_Text_Person8:
	.string "The castle's dinners are divine,\n"
	.string "darling. If only I could win more\l"
	.string "battles.$"

Sinnoh_BattleCastle_Text_Person9:
	.string "I collect the castle's commemorative\n"
	.string "cards. I have three!$"

