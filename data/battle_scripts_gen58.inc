BattleScript_G59SayIfAny::
	jumpifbyte CMP_EQUAL, cMULTISTRING_CHOOSER, 0xFF, BattleScript_G59Return
	printfromtable gGen59StringIds
	waitmessage B_WAIT_TIME_LONG
