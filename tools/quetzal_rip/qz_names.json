{
 "_note": "specials: names for every QZ_SPECIAL_<n> used in quetzal_rip (n = raw ROM index). stock_index_names: correct name for every raw index 0-539 (Quetzal inserted 13 specials inside the stock table: raw index != pokeemerald index; QzNew* = Quetzal additions). See docs/quetzal/SPECIALS.md.",
 "commands": {
  "0xE3": {
   "name": "bufferfollowerspecies",
   "args": "b strVarIndex (plays the follower's cry, buffers its species name; follower slot 1, or 2 in Giovanni mode)"
  },
  "0xE4": {
   "name": "getplayergender",
   "args": "- (VAR_RESULT = gSaveBlock2->playerGender, 0xFF in Giovanni mode)"
  },
  "0xE5": {
   "name": "questmenu",
   "args": "b op, b questVar (0 open quest menu [waits], 1 nop, 2 set flag, 3 VAR_RESULT=unlocked, 4 VAR_RESULT=flag, 5 buffer quest name)"
  },
  "0xE6": {
   "name": "waitframe_vars",
   "args": "b ignored, h var, h var (reads both, does nothing, yields one frame)"
  },
  "0xE7": {
   "name": "setfollowergfxvar",
   "args": "b mode (0 VAR_OBJ_GFX_ID_1, 1 VAR_OBJ_GFX_ID_F, 2 GFX_ID_1+GFX_ID_0, 3 VAR_OBJ_GFX_ID_3 from selected party mon)"
  },
  "0xE8": {
   "name": "dostaticwildbattle",
   "args": "- (scripted wild battle with legendary setup; waits)"
  },
  "0xE9": {
   "name": "givestorymon",
   "args": "h id (1 Spearow KENYA, 2 Shuckle SHUCKIE, 3 Rotom, 4 Dratini); VAR_RESULT = give result, 2 = Nuzlocke blocked"
  },
  "0xEA": {
   "name": "takebackstorymon",
   "args": "h id (1 KENYA, 2 SHUCKIE); VAR_RESULT 0 taken, 2 not found, 3 Shuckie friendship > 200 (player keeps it)"
  },
  "0xEB": {
   "name": "keeponlyleadmon",
   "args": "- (deletes party slots 1-5; VAR_RESULT 2 if lead fainted/egg, else 0)"
  },
  "0xEC": {
   "name": "setstaticwildmon",
   "args": "h species, b level, h item (creates gEnemyParty[0] and tags it as a static encounter)"
  },
  "0xED": {
   "name": "takepartymonofspecies",
   "args": "h species (slot in VAR_0x8004; VAR_RESULT 0 bad, 1 taken & Lv100 Magikarp, 2 taken, 3 last usable mon, 4 holds item)"
  },
  "0xEE": {
   "name": "checkpartymoninlist",
   "args": "b list 1-4 (slot VAR_0x8004; VAR_RESULT 1 if species in hard-coded list)"
  },
  "0xEF": {
   "name": "giveoddegg",
   "args": "h var (index 1-7 into table 0x095A4C14; Dizzy Punch egg; VAR_RESULT give result / 2 Nuzlocke)"
  },
  "0xF0": {
   "name": "addbattlepoints",
   "args": "h var/value (adds to frontier BP, cap 9999, and lifetime BP, cap 65535; buffers number)"
  },
  "0xF1": {
   "name": "nop_f1",
   "args": "-"
  },
  "0xF2": {
   "name": "nop_f2",
   "args": "-"
  },
  "0xF3": {
   "name": "nop_f3",
   "args": "-"
  },
  "0xF4": {
   "name": "nop_f4",
   "args": "-"
  },
  "0xF5": {
   "name": "checkmultiplayerorflag",
   "args": "- (VAR_RESULT 1 if MPlayer session active or saveblock2+0x2D0 bit1)"
  }
 },
