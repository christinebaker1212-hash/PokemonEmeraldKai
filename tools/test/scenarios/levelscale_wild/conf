# Level scaling, wild (mp_levelscale.c): a Lv46 team on Route 101 (Lv2-3 there). No badges: the cap holds them at 18.
# Eight badges: WILD MEDIUM (the default) puts them halfway between the area's level and the team's (22-24). Raised past
# its evolution level a wild one stays itself, except the rare evolved form (MOEMON_SCALE_RARE=1: always, here)
MODE=1
WARP=0,16,10,11
TMO=150
ENV_A="MOEMON_DEBUG_PARTY=283:46,280:46,277:46 MOEMON_LEVEL_SCALING=1 MOEMON_SCALE_RARE=1"
EXPECT_A=("-> Lv18 (team 46, cap 18)" "(team 46, cap 65)" "level scale: a rare evolved form" "level scale: evolved")
UNEXPECT_A=("-> Lv4" "-> Lv3")
