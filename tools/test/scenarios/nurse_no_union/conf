# CHERRYGROVE's nurse heals the POKeMON of a game started in JOHTO: she never says "It appears as if <junk> is playing
# right now". The wireless UNION ROOM check (union_room.c BufferUnionRoomPlayerName) read a name buffer that was all
# zeros until a HOENN or KANTO POKeMON CENTER's map ran InitUnionRoom (JOHTO's don't), so it copied memory past it.
# JOHTO's reminder flag FLAG_QZ_0xA98 (0x2A07 = 10759) is set only when that message shows.
MODE=1
TMO=150
ENV_A="MOEMON_DEBUG_REGION=1 MOEMON_DEBUG_PARTY=280:10"
EXPECT_A=("flag 10759 = 0" "ctx 1 free 1")
UNEXPECT_A=("flag 10759 = 1" "[crash]" "TIMEOUT")
# Shot nurse_says: her line after healing.
