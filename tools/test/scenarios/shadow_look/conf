# A Shadow Pokémon's dark palette (docs/SHADOW_POKEMON.md "Dark palettes"; src/data/orre_shadow_palettes.h from
# tools/orre/shadow_palettes.py): a QUILAVA (Colosseum's Shadow 3), facing a ZIGZAGOON, in its own colours, made Shadow (its dark
# MOéMON palette in battle), with OPTIONS > CREATURES on POKéMON (its dark POKéMON palette), purified (its own again).
# CHECK compares the four pictures' colours where the QUILAVA stands. Shots *.png; *_summary.png its front
# picture on the summary screen.
MODE=1
TMO=200
ENV_A="MOEMON_ORRE_SCRIPTS=0 MOEMON_DEBUG_PARTY=156:40"
EXPECT_A=("shadow: Shadow 3 (species 156) made" "shadow: Shadow 3 purified")
UNEXPECT_A=("[crash]" "TIMEOUT")
CHECK="python3 -I tools/orre/check_shadow_look.py"
