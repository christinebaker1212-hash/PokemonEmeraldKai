# The Garden's safety nets for saves from older Gardens: standing where nobody could (inside a tree: the layout
# changed) brings the player back to the escalator's landing; with no CENTER recorded (from before 1.16), the way
# down leads to the CENTER the game would rush them to after a loss (OLDALE's: the heal location). Shots stuck,
# landing, down.
MODE=1
TMO=120
WARP="0,57,15,1"
ENV_A="MOEMON_DEBUG_PARTY=280:15"
EXPECT_A=("garden: stuck, back to the landing" "[test] where map 0.57 xy 2,20" "[test] garden forget" "garden here 1 growth 0 badges 0 visited 1 lastpc 0" "return 0" "garden: down to center 0" "[test] where map 2.2 xy 2,6")
