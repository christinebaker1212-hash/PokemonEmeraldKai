# Black's camera shake (PROC_FLD_StartCameraShake, scrcmd_misc.c ShakeTask): DRAGONSPIRAL TOWER's script 1 shakes the
# view (3 units up and down, twelve swings of four frames, smaller after the first); the script waits for it. Shots cs_*.
MODE=1
TMO=200
ENV_A="MOEMON_DEBUG_REGION=4 MOEMON_DEBUG_PARTY=6:100"
EXPECT_A=("the camera shakes (0, 3, 12 swings of 4)" "[cs] done")
UNEXPECT_A=("[crash]" "TIMEOUT")
