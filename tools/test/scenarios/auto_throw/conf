# hard-to-catch Pokémon (three POKé BALLS) until that ball runs out (then the menu is the player's); a second battle: NO once (the menu back), then on, then L while
# the ball flies turns it off and the next turn's menu waits for the player.
MODE=1
TMO=200
ENV_A="MOEMON_DEBUG_PARTY=6:100"
