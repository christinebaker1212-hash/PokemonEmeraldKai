# CHATOT's CHATTER as it was in Platinum (src/mp/mp_chatter.c): CHATTER is in a CHATOT's party menu; Platinum's script
# asks to press A or B, the microphone (here MOEMON_MIC_WAV, a stand-in) hears a second, CHATOT learns the saying and
# its cry is the saying from then on ("<save>.chatter" keeps it); CHATTER again asks before forgetting it.
MODE=1
TMO=300
ENV_A="MOEMON_MIC_WAV=$(pwd)/tools/test/scenarios/chatter_record/voice.wav"
EXPECT_A=("microphone: recording from TEST MICROPHONE" "chatter: a new saying (byte 15 = 120)" "[test] chatter: own yes, byte 15 = 120, level 2" "chatter: CHATOT's saying (ours, mode 0" "chatter record done")
UNEXPECT_A=("crash" "out of memory" "no saying")
