# Platinum's DISTORTION WORLD events (src/sinnoh/s3d_distortion.c, overlay009's sMapEvents): on B2F the tile at
# (33, 225, 36) carries the player north on moving platform 1 (8 tiles), the player jumps 3 tiles onto the next
# island (MOVEMENT_ACTION_JUMP_DISTORTION_WORLD_NORTH) and the platform goes back. Needs the packs and the decomp.
MODE=1
TMO=200
ENV_A="MOEMON_TEST_STRONG=1 MOEMON_DEBUG_REGION=3"
EXPECT_A=("[dw] event at 33,225,36 (3 commands)" "[dw] settled at 33,225,28 on kind 4" "[dw] settled at 33,225,25 on kind 4" "[dw] floor 575 at 33,225,25")
UNEXPECT_A=("[crash]" "TIMEOUT" "not played yet")
