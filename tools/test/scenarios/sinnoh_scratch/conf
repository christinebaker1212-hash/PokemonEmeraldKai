# The BATTLE FRONTIER's Scratch-Off Cards (src/sinnoh/s3d_scratch.c, Platinum's art from the user's ROM:
# sinnoh/platinum_scratch.bin, tools/sinnoh/rom_pack.sh; Platinum's script scripts_scratch_off_cards.s converted): the
# attendant takes 1 BP, three cards are picked (LEFT / RIGHT, A), card 1 is scratched on the cells of three alike
# (coin moved by `mp scratchcell w`, A held) and wins; card 2 is stopped with B ("Stop scratching this card?" YES);
# card 3's three cells are scratched as they come; back on the field Platinum's script gives what was won. Needs the
# ROM's pack. Shots sc_*.png.
MODE=1
TMO=300
ENV_A="MOEMON_DEBUG_REGION=3"
EXPECT_A=("sinnoh scratch: open" "sinnoh scratch: card no. 3 is" "sinnoh scratch: three alike" "sinnoh scratch: card 1 won" "\"Stop scratching this card?\"" "scratch: 1 of 1 prizes in the bag")
UNEXPECT_A=("[crash]" "TIMEOUT" "isn't the Scratch-Off" "no art")
